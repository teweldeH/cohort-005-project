#!/usr/bin/env sh
# Fast checks on the staged files only. `npm run check` is too slow to run
# on every commit; run it before you report a change as done. See AGENTS.md.
set -e

# Every staged file must fit in an agent's context in one read.
npx tsx scripts/check-staged-file-size.ts

# Migrations are forward-only: add a new one instead of editing a shipped one.
if ! git diff --cached --diff-filter=MD --quiet -- 'drizzle/*.sql'; then
  echo "Commit refused: it edits or deletes an existing migration in drizzle/." >&2
  echo "Restore it and run \`npm run db:generate\` to add a new migration." >&2
  exit 1
fi
